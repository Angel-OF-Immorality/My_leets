     "text": [
      "[['eat', 'tea', 'ate'], ['tan', 'nat'], ['bat']]\n"
     ]
    }
   ],
   "source": [
    "from collections import defaultdict\n",
    "words = defaultdict(list)\n",
    "for word in strs:\n",
    "    key = tuple(sorted(word))\n",
    "    words[key].append(word)\n",
    "\n",
    "print(list(words.values()))"
   ]
